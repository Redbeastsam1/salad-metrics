# Machine name displayed on the dashboard & Discord embeds
MACHINE_NAME=Beast

# Optional Discord Bot (leave blank to disable Discord bot)
DISCORD_BOT_TOKEN=
# Optional channel ID for crash alerts (bot will send offline/crash pings here)
DISCORD_CHANNEL_ID=

# Set to run in Agent mode pointing to your Ubuntu Server (e.g. http://192.168.1.100:8000)
# Leave blank to run in Standalone mode (all-in-one on this PC)
SERVER_URL=
